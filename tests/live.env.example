# Configuration for the LIVE gates: the tests that drive a real, running
# SSHDeck and a real SSH target, rather than a stubbed page.
#
#   cp tests/live.env.example tests/live.env     # then fill it in
#   node tests/browser/live_e2e_v5.mjs
#   node scripts/run_gates.mjs --live            # every live gate
#
# tests/live.env is ignored by git. Point somewhere else with LIVE_CREDS_FILE
# if you keep the values outside the checkout:
#
#   LIVE_CREDS_FILE=/etc/sshdeck/live.env node scripts/run_gates.mjs --live
#
# The gates read these values, never print them, and report a missing one by
# NAME only. Everything here is a secret except LIVE_BASE and SSH_AUTH_TYPE.
# Use a throwaway account and a host you own.

# The SSHDeck instance under test, as a browser would reach it.
LIVE_BASE=http://127.0.0.1:5000

# An SSHDeck account the gates log in with. It needs no special role, but it
# does need to be allowed to open sessions, and the login rate limit applies
# (five per minute by default), so the gates budget one login per run.
LIVE_USER=
LIVE_PASS=

# The SSH target the gates connect that account to. A container or a VM you
# can throw away is the right thing here: the gates create and destroy tmux
# sessions on it, type into shells and transfer files.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASS=

# How the gates authenticate to SSH_HOST:
#   password   - SSH_USER / SSH_PASS as typed into the connection form
#   tailscale  - the shared Tailscale identity of the machine running SSHDeck,
#                in which case SSH_PASS is unused but SSH_USER still names the
#                remote account
SSH_AUTH_TYPE=password
